# Example: Next.js app from Turbo monorepo → container
# Copy to: apps/quickbooks-killer/Dockerfile (adjust APP_PACKAGE name)
#
# Prereq: in next.config.js add:  output: 'standalone'
# Build from REPO ROOT:  docker build -f apps/quickbooks-killer/Dockerfile .

ARG APP_PACKAGE=@curriculum/quickbooks-killer

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app

# --- prune monorepo to this app + its dependencies ---
FROM base AS pruner
RUN npm install -g turbo@2
COPY . .
RUN turbo prune ${APP_PACKAGE} --docker

# --- install deps (cached when lockfile unchanged) ---
FROM base AS deps
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/package-lock.json ./package-lock.json
RUN npm ci

# --- build ---
FROM base AS builder
COPY --from=deps /app/ .
COPY --from=pruner /app/out/full/ .
RUN npm install -g turbo@2
RUN turbo run build --filter=${APP_PACKAGE}

# --- production runner ---
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

# Adjust paths if your Next app lives under apps/quickbooks-killer
COPY --from=builder --chown=nextjs:nodejs /app/apps/quickbooks-killer/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/quickbooks-killer/.next/static ./apps/quickbooks-killer/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/quickbooks-killer/public ./apps/quickbooks-killer/public

USER nextjs
EXPOSE 3100
ENV PORT=3100
ENV HOSTNAME=0.0.0.0
CMD ["node", "apps/quickbooks-killer/server.js"]
