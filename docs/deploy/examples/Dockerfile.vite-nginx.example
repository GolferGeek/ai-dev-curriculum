# Example: Vite static app → nginx
# Copy to: apps/ops-pulse/Dockerfile
# Build from REPO ROOT:  docker build -f apps/ops-pulse/Dockerfile .

ARG APP_PACKAGE=@curriculum/ops-pulse

FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat

FROM base AS pruner
RUN npm install -g turbo@2
COPY . .
RUN turbo prune ${APP_PACKAGE} --docker

FROM base AS deps
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/package-lock.json ./package-lock.json
RUN npm ci

FROM base AS builder
COPY --from=deps /app/ .
COPY --from=pruner /app/out/full/ .
RUN npm install -g turbo@2
RUN turbo run build --filter=${APP_PACKAGE}

FROM nginx:alpine AS runner
COPY docs/deploy/examples/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/ops-pulse/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
